# FINOVEXA AI — backend environment template
# Copy to backend/.env and replace every placeholder. Never commit a real .env.
# All credentials are read by the backend only; the browser receives booleans and modes.

ENV=development
SECRET_KEY=replace-with-a-long-random-secret
# Encrypts Payment Connect statement originals. Leave blank in development to derive
# it from SECRET_KEY. In production set it once and never rotate it, otherwise
# previously stored statement files become unreadable.
# Generate: python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
PAYMENT_DOCUMENT_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
DATABASE_URL=sqlite:///./finovexa.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
AUTO_SEED=true
DEMO_RESET_ENABLED=true
# false = clean start: customers, products and settings seeded with zero balances and
# no invoices, payments, expenses or portfolio. true = full demo ledger for walkthroughs.
SEED_DEMO_TRANSACTIONS=false

# Demo account. These are published demo-only values, not real user credentials.
DEMO_EMAIL=demo@finovexa.ai
DEMO_PASSWORD=Demo1234!
# Seeded employee login linked to the demo owner. Published demo-only values.
DEMO_EMPLOYEE_EMAIL=employee@finovexa.ai
DEMO_EMPLOYEE_PASSWORD=Employee1234!

# Developer console account. Provisioned only from the backend environment; the
# account cannot be created or promoted from the app. Leave blank to disable the
# developer portal. Password must be at least 12 characters with a letter and digit.
# Use a unique secret in production and never commit a real .env.
DEVELOPER_NAME=Platform Developer
DEVELOPER_EMAIL=
DEVELOPER_PASSWORD=

# First production accounts, created once at startup and never overwritten.
# Leave blank locally; set them in the host environment for a clean deployment.
# Passwords need at least 12 characters with a letter and a number.
INITIAL_OWNER_NAME=
INITIAL_OWNER_EMAIL=
INITIAL_OWNER_PASSWORD=
INITIAL_BUSINESS_NAME=
INITIAL_SENIOR_ACCOUNTANT_NAME=
INITIAL_SENIOR_ACCOUNTANT_EMAIL=
INITIAL_SENIOR_ACCOUNTANT_PASSWORD=
INITIAL_JUNIOR_ACCOUNTANT_NAME=
INITIAL_JUNIOR_ACCOUNTANT_EMAIL=
INITIAL_JUNIOR_ACCOUNTANT_PASSWORD=

# local = write uploads to disk; database = keep uploaded bytes in the database
# so they survive redeploys on hosts without a persistent disk.
FILE_STORAGE=local
ACCOUNTING_UPLOAD_DIR=uploads/accounting

# Optional AI orchestrator. When unset, FINOVEXA uses its deterministic rules analyst.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45

# Optional PayPal. When unset, the Payment Center uses clearly labelled simulation.
# Start with sandbox. Never put production credentials in a development .env.
# Both pairs can be present; the owner chooses the active environment in Settings.
# Secrets are read by the backend only and are never sent to the browser or logged.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_SANDBOX_WEBHOOK_ID=
PAYPAL_SANDBOX_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_LIVE_WEBHOOK_ID=
PAYPAL_LIVE_BASE_URL=https://api-m.paypal.com
# Legacy single-environment names are still honoured when the scoped pair above is empty.
# They default to the sandbox host and are kept for older deployments only.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
# Local demo HMAC secret. Used only when no PayPal credentials are configured.
PAYPAL_DEMO_WEBHOOK_SECRET=replace-with-a-local-demo-only-secret

# Optional Upstox market data and live order routing.
# Without a token every price is labelled DEMO and live execution stays unavailable.
# Live trading is off by default. When enabled it still requires a live quote, an INR
# business profile and explicit owner approval on every order. Never commit a token.
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/integrations/upstox/callback
UPSTOX_ACCESS_TOKEN=
UPSTOX_BASE_URL=https://api.upstox.com/v2
UPSTOX_SANDBOX_URL=https://sandbox-api.upstox.com/v2
UPSTOX_ORDER_BASE_URL=https://api-hft.upstox.com/v2
# Upstox requires order traffic from a registered static IP. Point this at an HTTPS
# egress proxy that exits from that IP; leave empty only if this host is registered.
UPSTOX_ORDER_PROXY_URL=
UPSTOX_LIVE_TRADING_ENABLED=false

# Keyless NSE/BSE quote source for the Investment Research market panel. Yahoo
# publishes this data with a delay, so the UI always labels it DELAYED. No key or
# account is required; override the host only if you front it with a proxy.
YAHOO_FINANCE_BASE_URL=https://query1.finance.yahoo.com
INDIA_MARKET_CACHE_SECONDS=60

# Encrypted backup key for scripts/backup_db.py (URL-safe base64, 32 bytes).
# Generate once with: python scripts/backup_db.py keygen --key-file backups/backup.key
# Store the key outside the repository; losing it makes encrypted backups unreadable.
BACKUP_ENCRYPTION_KEY=

# Optional market data. When unset, seeded DEMO quotes and headlines are used.
METALS_API_KEY=
METALS_API_URL=https://api.metals.dev/v1/latest
NEWS_API_KEY=
QUOTE_CACHE_MINUTES=15
NEWS_CACHE_MINUTES=60
