# Copy to /opt/finovexa/env/api.env on the VM (chmod 600, owned by root).
# Never commit the filled file. Values below are placeholders.

ENV=production
SECRET_KEY=CHANGE_ME_64_RANDOM_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Managed Postgres (Neon free tier or similar). Paste the full URL, including
# the sslmode parameter, and never commit the filled file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Production safety: no seeding, no demo reset endpoint.
AUTO_SEED=false
DEMO_RESET_ENABLED=false
SEED_DEMO_TRANSACTIONS=false

# Uploaded accounting documents live in the database so they survive redeploys
# on hosts without a persistent disk.
FILE_STORAGE=database
ACCOUNTING_MAX_UPLOAD_MB=10
ACCOUNTING_TALLY_RETENTION_DAYS=2555

# First production accounts, created once on startup. Existing accounts are
# never modified. Passwords must be at least 12 characters with a letter and a number.
INITIAL_OWNER_NAME=
INITIAL_OWNER_EMAIL=
INITIAL_OWNER_PASSWORD=
INITIAL_BUSINESS_NAME=
INITIAL_SENIOR_ACCOUNTANT_NAME=
INITIAL_SENIOR_ACCOUNTANT_EMAIL=
INITIAL_SENIOR_ACCOUNTANT_PASSWORD=
INITIAL_JUNIOR_ACCOUNTANT_NAME=
INITIAL_JUNIOR_ACCOUNTANT_EMAIL=
INITIAL_JUNIOR_ACCOUNTANT_PASSWORD=

# Must be carried over from the current deployment: Payment Connect statement
# originals are encrypted with it and become unreadable if it changes.
PAYMENT_DOCUMENT_KEY=

# AES-256-GCM key for scripts/backup_db.py (url-safe base64, 32 bytes).
# Generate once locally: python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
BACKUP_ENCRYPTION_KEY=

# Frontend origin(s). Add the custom domain once it is attached to Pages.
CORS_ORIGINS=https://finovexa.pages.dev
FRONTEND_URL=https://finovexa.pages.dev

DEVELOPER_NAME=Platform Developer
DEVELOPER_EMAIL=
DEVELOPER_PASSWORD=

# Optional integrations; leave blank to keep them in their simulated/demo mode.
LLM_PROVIDER=none
LLM_API_KEY=

PAYPAL_ENVIRONMENT=sandbox
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_SANDBOX_WEBHOOK_ID=

UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=https://api.example.com/api/integrations/upstox/callback
UPSTOX_ACCESS_TOKEN=
UPSTOX_LIVE_TRADING_ENABLED=false

METALS_API_KEY=
NEWS_API_KEY=

EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=FINOVEXA AI
SMS_DELIVERY_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
